# Copy these into Netlify: Site configuration > Environment variables

# Admin sign in (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# Signs admin sessions (recommended): any long random string
AUTH_SECRET=paste-a-long-random-string-here

# Email through Resend (https://resend.com): customer confirmations, receipts, checklists and alerts to your inbox
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must use a domain you verified in Resend
EMAIL_FROM=FreshNest Cleaning <bookings@yourdomain.com>

# Optional: your public address, used in email links
# SITE_URL=https://www.yourdomain.com

# Optional: AI quotation assistant (Anthropic). Without it, a built-in keyword reader fills the form instead.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# AI_MODEL=claude-haiku-4-5-20251001
